---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const questions = await getCollection('coding-questions');
  return questions.map(q => ({ params: { id: q.id }, props: { question: q } }));
}

const { question } = Astro.props;
const { data: q } = question;
const { Content } = await render(question);

const statusLabel: Record<string, string> = {
  verified_pyq: 'Verified PYQ',
  practice: 'Practice',
  unclassified: 'Unclassified',
};

// Get adjacent questions for prev/next
const all = (await getCollection('coding-questions')).sort((a,b) => a.data.title.localeCompare(b.data.title));
const idx  = all.findIndex(x => x.id === question.id);
const prev = idx > 0          ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
const allNotes = await getCollection('topic-notes');
---
<Layout title={q.title} description={`${q.title} — TCS NQT ${q.status} [${q.difficulty}]`}>
  <div class="page-shell no-sidebar">
    <div class="detail-grid">
      <main class="main-content detail-main" data-pagefind-body>

      <!-- Breadcrumb -->
      <div class="detail-breadcrumb">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/coding`}>← Coding Questions</a>
      </div>

      <!-- Header -->
      <div class="detail-header">
        <h1 class="detail-title">{q.title}</h1>
        <div class="detail-badges">
          <span class={`badge badge-${q.difficulty}`}>
            {q.difficulty === 'easy' ? 'E' : q.difficulty === 'medium' ? 'M' : q.difficulty === 'hard' ? 'H' : ''} · {q.difficulty}
          </span>
          <span class={`badge badge-${q.status}`}>
            {q.status === 'verified_pyq' ? 'P · ' : ''}{statusLabel[q.status]}
          </span>
          {q.ambiguousFormat && (
            <span class="badge" style="color:var(--difficulty-medium);background:var(--difficulty-medium-bg)">Ambiguous I/O</span>
          )}
          {q.topics.map(t => <span class="tag">{t}</span>)}
          <div class="detail-actions" style="margin-left:auto; display:flex; gap:var(--space-2);">
            <button class="action-btn" id="review-btn" data-id={q.id} title="Needs Review">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </button>
            <button class="action-btn" id="bookmark-btn" data-id={q.id} title="Bookmark">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </button>
            <button class="done-btn" id="done-btn" data-id={q.id}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span id="done-label">Mark solved</span>
            </button>
          </div>
        </div>
      </div>

      {q.variants && q.variants.length > 0 && (
        <div class="variants-warning" style="margin-bottom:var(--space-6); padding:var(--space-4); background:var(--paper-alt); border:1px solid var(--border); border-radius:var(--radius-md); border-left:4px solid var(--accent);">
          <div style="font-weight:600; font-size:var(--text-sm); margin-bottom:var(--space-2); color:var(--accent);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Known Variant
          </div>
          <p style="margin:0; font-size:var(--text-sm); color:var(--ink-muted);">
            This problem appears multiple times in past papers. Related variants: 
            {q.variants.map((vId, i) => {
              const v = all.find(x => x.id === vId);
              return v ? (
                <span>
                  <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/coding/${v.id}`} style="color:var(--ink); font-weight:500;">{v.data.title}</a>
                  {i < (q.variants?.length ?? 0) - 1 ? ', ' : ''}
                </span>
              ) : null;
            })}
          </p>
        </div>
      )}

      <!-- Problem statement -->
      <div class="detail-section">
        <div class="detail-section-label">Problem</div>
        <div class="detail-body"><Content /></div>
      </div>

      {q.constraints && (
        <div class="detail-section">
          <div class="detail-section-label">Constraints</div>
          <div class="detail-body" style="font-family:var(--font-mono);font-size:var(--text-sm)">{q.constraints}</div>
        </div>
      )}

      <!-- Sample I/O -->
      {(q.sampleInput || q.sampleOutput) && (
        <div class="detail-section">
          <div class="detail-section-label">Example</div>
          <div class="io-grid">
            {q.sampleInput && (
              <div class="io-block">
                <div class="io-block-label">Input</div>
                <pre>{q.sampleInput}</pre>
              </div>
            )}
            {q.sampleOutput && (
              <div class="io-block">
                <div class="io-block-label">Output</div>
                <pre>{q.sampleOutput}</pre>
              </div>
            )}
          </div>
        </div>
      )}

      {q.ambiguousFormat && (
        <div class="warn-banner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          The I/O format for this question is intentionally ambiguous — TCS NQT sometimes omits full specs. Practice parsing.
        </div>
      )}

      <!-- Hint (spoiler) -->
      {q.hint && (
        <div class="detail-section">
          <div class="spoiler" id="hint-spoiler">
            <button class="spoiler-toggle" aria-expanded="false" aria-controls="hint-body">
              <span>Hint</span>
              <svg class="spoiler-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="spoiler-body" id="hint-body">{q.hint}</div>
          </div>
        </div>
      )}

      <!-- Explanation (spoiler) -->
      {q.explanation && (
        <div class="detail-section">
          <div class="spoiler">
            <button class="spoiler-toggle" aria-expanded="false" aria-controls="expl-body">
              <span>Explanation</span>
              <svg class="spoiler-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="spoiler-body" id="expl-body">{q.explanation}</div>
          </div>
        </div>
      )}

      <!-- Solutions (spoiler) -->
      {q.referenceCode && q.referenceCode.length > 0 && (
        <div class="detail-section">
          <div class="spoiler">
            <button class="spoiler-toggle" aria-expanded="false" aria-controls="sol-body">
              <span>Solution{q.referenceCode.length > 1 ? 's' : ''}</span>
              {!q.referenceCode[0].verified && (
                <span class="badge badge-practice" style="margin-left:var(--space-2);font-weight:400">unverified</span>
              )}
              <svg class="spoiler-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="spoiler-body" id="sol-body">
              {q.referenceCode.map((rc, i) => (
                <div class="code-block" style={i > 0 ? 'margin-top:var(--space-4)' : ''}>
                  <div class="code-block-header">
                    <span class="code-lang">{rc.lang}</span>
                    {!rc.verified && <span style="font-size:var(--text-xs);color:var(--ink-muted)">may contain transcription errors</span>}
                    <button class="copy-btn" data-code={rc.code}>Copy</button>
                  </div>
                  <pre>{rc.code}</pre>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {q.note && (
        <div class="detail-section" style="padding:var(--space-3) var(--space-4);background:var(--paper-alt);border-radius:var(--radius-md);font-size:var(--text-sm);color:var(--ink-muted);">
          <strong>Note:</strong> {q.note}
        </div>
      )}

      <!-- Prev / Next nav -->
      <div style="display:flex;justify-content:space-between;margin-top:var(--space-12);padding-top:var(--space-4);border-top:1px solid var(--border);font-size:var(--text-sm);">
        {prev
          ? <a id="nav-prev" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/coding/${prev.id}`}>← {prev.data.title}</a>
          : <span/>
        }
        {next && <a id="nav-next" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/coding/${next.id}`}>{next.data.title} →</a>}
      </div>

      <!-- Report issue link -->
      <div style="display:flex;justify-content:center;margin-top:var(--space-8);">
        <a href="https://github.com/diluteoxygen/TCS-NQT-PYQ/issues/new" target="_blank" rel="noopener" style="font-size:var(--text-sm);color:var(--ink-muted);display:flex;align-items:center;gap:6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Report an issue with this question
        </a>
      </div>

    </main>

    {(() => {
      // Find related DSA patterns based on matching topics
      const relatedNotes = allNotes.filter(n => {
        if (n.data.category !== 'dsa-patterns') return false;
        return q.topics.some(t => {
          const topicWord = t.toLowerCase().replace('-', ' ');
          if (topicWord === 'arrays') return n.data.title.toLowerCase().includes('array');
          if (topicWord === 'strings') return n.data.title.toLowerCase().includes('string');
          if (topicWord === 'linked-list') return n.data.title.toLowerCase().includes('linked list');
          return n.data.title.toLowerCase().includes(topicWord);
        });
      });
      
      if (relatedNotes.length === 0) return null;
      
      return (
        <aside class="detail-aside">
          <div class="related-notes" style="padding:var(--space-4); background:var(--paper-alt); border:1px solid var(--border); border-radius:var(--radius-md);">
            <div style="font-weight:600; font-size:var(--text-sm); margin-bottom:var(--space-2); display:flex; align-items:center; gap:6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              Related Study Notes
            </div>
            <ul style="margin:0; padding-left:var(--space-4); font-size:var(--text-sm);">
              {relatedNotes.map(n => (
                <li style="margin-bottom:var(--space-1);"><a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/notes/${n.id}`} style="color:var(--ink);">{n.data.title}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      );
    })()}

    </div>
  </div>

  <style>
    .detail-grid {
      display: flex;
      flex-direction: column;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 var(--space-4);
      gap: var(--space-6);
    }
    .detail-main {
      flex: 1;
      min-width: 0;
      padding: var(--space-6) 0;
    }
    @media (min-width: 1024px) {
      .detail-grid {
        flex-direction: row;
        align-items: flex-start;
      }
      .detail-main {
        max-width: 54rem;
        padding: var(--space-6) var(--space-8);
      }
      .detail-aside {
        width: 18rem;
        flex-shrink: 0;
        position: sticky;
        top: calc(var(--nav-height) + var(--space-6));
        padding-top: var(--space-6);
      }
    }
  </style>

  <script>
    // ── Spoilers ──────────────────────────────────────────────
    document.querySelectorAll<HTMLElement>('.spoiler-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const bodyId = btn.getAttribute('aria-controls')!;
        document.getElementById(bodyId)!.classList.toggle('open', !expanded);
      });
    });

    // ── Copy buttons ──────────────────────────────────────────
    document.querySelectorAll<HTMLElement>('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.dataset.code || '';
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy', 1500);
      });
    });

    // ── Interaction State ─────────────────────────────────────
    const doneBtn = document.getElementById('done-btn') as HTMLButtonElement;
    const doneLabel = document.getElementById('done-label')!;
    const reviewBtn = document.getElementById('review-btn') as HTMLButtonElement;
    const bookmarkBtn = document.getElementById('bookmark-btn') as HTMLButtonElement;
    const id = doneBtn.dataset.id!;
    
    const solved: Set<string> = new Set(JSON.parse(localStorage.getItem('solved-coding') || '[]'));
    const review: Set<string> = new Set(JSON.parse(localStorage.getItem('review-coding') || '[]'));
    const bookmark: Set<string> = new Set(JSON.parse(localStorage.getItem('bookmark-coding') || '[]'));

    function refreshState() {
      // Solved state
      if (solved.has(id)) {
        doneBtn.classList.add('done');
        doneLabel.textContent = 'Solved';
        doneBtn.style.background = 'var(--primary)';
        doneBtn.style.color = 'var(--bg)';
        doneBtn.style.borderColor = 'var(--primary)';
      } else {
        doneBtn.classList.remove('done');
        doneLabel.textContent = 'Mark solved';
        doneBtn.style.background = '';
        doneBtn.style.color = '';
        doneBtn.style.borderColor = '';
      }
      
      // Review state
      if (review.has(id)) {
        reviewBtn.classList.add('active');
        reviewBtn.style.color = 'var(--difficulty-medium)';
        reviewBtn.style.borderColor = 'var(--difficulty-medium)';
        reviewBtn.style.background = 'var(--difficulty-medium-bg)';
      } else {
        reviewBtn.classList.remove('active');
        reviewBtn.style.color = '';
        reviewBtn.style.borderColor = '';
        reviewBtn.style.background = '';
      }

      // Bookmark state
      if (bookmark.has(id)) {
        bookmarkBtn.classList.add('active');
        bookmarkBtn.style.color = 'var(--ink)';
        bookmarkBtn.style.borderColor = 'var(--ink)';
        bookmarkBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';
      } else {
        bookmarkBtn.classList.remove('active');
        bookmarkBtn.style.color = '';
        bookmarkBtn.style.borderColor = '';
        bookmarkBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';
      }
    }
    
    refreshState();
    
    doneBtn.addEventListener('click', () => {
      if (solved.has(id)) solved.delete(id);
      else { solved.add(id); review.delete(id); } // mutually exclusive with review
      localStorage.setItem('solved-coding', JSON.stringify([...solved]));
      localStorage.setItem('review-coding', JSON.stringify([...review]));
      refreshState();
    });

    reviewBtn.addEventListener('click', () => {
      if (review.has(id)) review.delete(id);
      else { review.add(id); solved.delete(id); } // mutually exclusive with solved
      localStorage.setItem('review-coding', JSON.stringify([...review]));
      localStorage.setItem('solved-coding', JSON.stringify([...solved]));
      refreshState();
    });

    bookmarkBtn.addEventListener('click', () => {
      if (bookmark.has(id)) bookmark.delete(id);
      else bookmark.add(id);
      localStorage.setItem('bookmark-coding', JSON.stringify([...bookmark]));
      refreshState();
    });

    // ── Keyboard Navigation ───────────────────────────────────
    document.addEventListener('keydown', (e) => {
      // Ignore if typing in input
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      
      const prevLink = document.getElementById('nav-prev') as HTMLAnchorElement;
      const nextLink = document.getElementById('nav-next') as HTMLAnchorElement;
      
      if (e.key === 'ArrowLeft' || e.key === 'j') {
        if (prevLink) prevLink.click();
      } else if (e.key === 'ArrowRight' || e.key === 'k') {
        if (nextLink) nextLink.click();
      }
    });
  </script>
</Layout>
