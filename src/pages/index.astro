---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Spotlight from '../components/Spotlight.astro';

const coding  = await getCollection('coding-questions');
const mcqs    = await getCollection('mcq-items');
const papers  = await getCollection('papers');
const notes   = await getCollection('topic-notes');

const verifiedCount  = coding.filter(q => q.data.status === 'verified_pyq').length;
const hrCount        = notes.filter(n => n.data.category === 'hr-interview').length;
const dsaCount       = notes.filter(n => n.data.category === 'dsa-patterns').length;

---
<Layout title="Home">
  <main class="page-shell no-sidebar">
    <div class="main-content">

      <!-- Page header — no hero, no blob, no gradient -->
      <div class="page-header" style="border-bottom: none; margin-bottom: var(--space-8);">
        <h1 class="page-title" style="font-size: var(--text-3xl);">TCS NQT Question Bank</h1>
        <p class="page-subtitle">
          All content sourced from verified previous-year questions. Progress saves locally in your browser.
        </p>
      </div>

      <div class="home-grid" style="margin-top: 0; margin-bottom: var(--space-8);">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/coding`} class="home-card">
          <div class="home-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Coding Questions
            <svg class="home-card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="home-card-desc">
            Practice problems with sample I/O, hints, and solutions.
            Filter by difficulty, topic, or exam date.
          </div>
          <div class="home-card-stat">
            <strong>{coding.length}</strong> problems ·
            <strong>{verifiedCount}</strong> verified PYQs
          </div>
        </a>

        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/mcq`} class="home-card">
          <div class="home-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            MCQ Bank
            <svg class="home-card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="home-card-desc">
            Quantitative Aptitude, Logical Reasoning, Verbal Ability, Programming Concepts, and more.
            Select an option to reveal the answer.
          </div>
          <div class="home-card-stat">
            <strong>{mcqs.length}</strong> questions across <strong>{papers.length}</strong> sources
          </div>
        </a>

        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/papers`} class="home-card">
          <div class="home-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Previous Year Papers
            <svg class="home-card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="home-card-desc">
            Full papers (Numerical, Verbal, Reasoning, Advanced Coding) in one scrollable view.
            Print-friendly for offline practice.
          </div>
          <div class="home-card-stat">
            <strong>{papers.length}</strong> full papers available
          </div>
        </a>

        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/notes`} class="home-card">
          <div class="home-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Study Notes
            <svg class="home-card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="home-card-desc">
            HR interview answers, DSA pattern catalog with Java / C++ / Python solutions.
          </div>
          <div class="home-card-stat">
            <strong>{hrCount}</strong> HR answers · <strong>{dsaCount}</strong> DSA patterns
          </div>
        </a>
      </div>

      <Spotlight />

    </div>
  </main>
</Layout>
