---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('topic-notes');
  return notes.map(n => ({ params: { id: n.id }, props: { note: n } }));
}

const { note } = Astro.props;
const { data: n } = note;
const { Content } = await render(note);

const categoryLabel: Record<string, string> = {
  'hr-interview': 'HR Interview',
  'dsa-patterns': 'DSA Patterns',
};

const allCoding = await getCollection('coding-questions');
const relatedCoding = n.category === 'dsa-patterns' 
  ? allCoding.filter(q => q.data.topics.some(t => {
      const topicWord = t.toLowerCase().replace('-', ' ');
      if (topicWord === 'arrays') return n.title.toLowerCase().includes('array');
      if (topicWord === 'strings') return n.title.toLowerCase().includes('string');
      if (topicWord === 'linked-list') return n.title.toLowerCase().includes('linked list');
      return n.title.toLowerCase().includes(topicWord);
    })).sort((a,b) => a.data.title.localeCompare(b.data.title))
  : [];
---
<Layout title={n.title}>
  <div class="page-shell no-sidebar">
    <main class="main-content" style="max-width:54rem;" data-pagefind-body>
      <div class="detail-breadcrumb">
        <a href={`${import.meta.env.BASE_URL}notes`}>← Notes</a> / {categoryLabel[n.category] ?? n.category}
      </div>
      <div class="detail-header">
        <h1 class="detail-title">{n.title}</h1>
        <div class="detail-badges">
          <span class="badge badge-unclassified">{categoryLabel[n.category] ?? n.category}</span>
        </div>
      </div>
      <div class="note-content">
        <Content />
      </div>

      {relatedCoding.length > 0 && (
        <div class="related-coding" style="margin-top:var(--space-8); padding:var(--space-4); background:var(--paper-alt); border:1px solid var(--border); border-radius:var(--radius-md);">
          <div style="font-weight:600; font-size:var(--text-md); margin-bottom:var(--space-3); color:var(--ink);">Related Practice Problems</div>
          <div style="display:flex; flex-direction:column; gap:var(--space-2);">
            {relatedCoding.map(q => (
              <a href={`${import.meta.env.BASE_URL}coding/${q.id}`} style="display:flex; align-items:center; gap:var(--space-2); color:var(--ink); text-decoration:none; padding:var(--space-2); border-radius:var(--radius-sm); border:1px solid var(--border); background:var(--paper); transition:border-color 0.1s;">
                <span class={`badge badge-${q.data.difficulty}`} style="min-width:40px; text-align:center;">
                  {q.data.difficulty === 'easy' ? 'E' : q.data.difficulty === 'medium' ? 'M' : q.data.difficulty === 'hard' ? 'H' : q.data.difficulty}
                </span>
                <span style="font-weight:500;">{q.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Report issue link -->
      <div style="display:flex;justify-content:center;margin-top:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--border);">
        <a href="https://github.com/diluteoxygen/TCS-NQT-PYQ/issues/new" target="_blank" rel="noopener" style="font-size:var(--text-sm);color:var(--ink-muted);display:flex;align-items:center;gap:6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Report an issue with this note
        </a>
      </div>
    </main>
  </div>
</Layout>
