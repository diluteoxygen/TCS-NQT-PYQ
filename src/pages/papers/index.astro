---
import Layout from '../../layouts/Layout.astro';
import PaperListItem from '../../components/PaperListItem.astro';
import { getCollection } from 'astro:content';

const papers = await getCollection('papers');
const sorted = papers.sort((a, b) => {
  if (a.data.id === 'pyq-300') return 1;
  if (b.data.id === 'pyq-300') return -1;
  return a.data.title.localeCompare(b.data.title);
});
---
<Layout title="Previous Year Papers">
  <div class="page-shell no-sidebar">
    <main class="main-content">
      <div class="page-header">
        <h1 class="page-title">Previous Year Papers</h1>
        <p class="page-subtitle">Full papers for timed mock practice. Print-friendly view available on each paper.</p>
      </div>

      <div class="list-meta">
        <span>{papers.length} papers</span>
        <span style="font-size:var(--text-xs)">Numerical · Verbal · Reasoning · Coding</span>
      </div>

      <div class="q-list">
        {sorted.map(p => (
          <PaperListItem 
            title={p.data.title}
            sections={p.data.sections}
            questionCount={p.data.questionCount}
            href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/papers/${p.data.id}`}
          />
        ))}
      </div>
    </main>
  </div>
</Layout>
